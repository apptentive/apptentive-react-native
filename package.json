{
  "name": "apptentive-react-native",
  "version": "7.1.0",
  "description": "React Native Module for Apptentive SDK",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "apptentive-react-native.podspec",
    "!lib/typescript/example",
    "!android/build",
    "!ios/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "test": "jest",
    "typescript": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "prepare": "bob build",
    "release": "release-it",
    "example": "yarn --cwd example",
    "pods": "cd example && pod-install --quiet",
    "bootstrap": "yarn example && yarn && yarn pods"
  },
  "keywords": [
    "apptentive",
    "react-native",
    "ios",
    "android"
  ],
  "author": "Apptentive <sdks@apptentive.com> (https://github.com/apptentive)",
  "contributors": [
    "Frank Schmitt",
    "Chase Olson",
    "Poornima Nagarajan",
    "Luqmaan Khan"
  ],
  "repository": "https://github.com/apptentive/apptentive-react-native",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/apptentive/apptentive-react-native/issues"
  },
  "homepage": "https://github.com/apptentive/apptentive-react-native#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": ">=18.3.1",
    "react-native": ">=0.77.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.0.0",
    "@react-native-community/eslint-config": "^2.0.0",
    "@release-it/conventional-changelog": "^7.0.2",
    "@types/jest": "^29.5.12",
    "@types/react": "18.3.3",
    "@types/react-native": "0.73.0",
    "commitlint": "^19.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^3.4.1",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "pod-install": "^0.1.39",
    "prettier": "^3.2.5",
    "react": "18.3.1",
    "react-native": "0.77.0",
    "react-native-builder-bob": "^0.23.2",
    "release-it": "^16.0.0",
    "typescript": "^5.4.2"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native-community",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
